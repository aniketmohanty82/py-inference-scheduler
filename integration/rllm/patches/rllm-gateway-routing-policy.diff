From 20d55a32f16bdb84d99ce6cc41a1514eb4979aa5 Mon Sep 17 00:00:00 2001
From: Aniket Mohanty <aniketmohanty@google.com>
Date: Wed, 12 Aug 2026 21:38:09 +0000
Subject: [PATCH] gateway: expose routing_policy through GatewayManager and env

- RLLM_GATEWAY_ROUTING_POLICY env var accepted by the gateway server
  (process mode inherits it from the trainer environment)
- rllm.gateway.routing_policy config key plumbed through GatewayManager
  into both subprocess and thread launch modes

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 rllm-model-gateway/src/rllm_model_gateway/server.py |  1 +
 rllm/gateway/manager.py                             | 10 +++++++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/rllm-model-gateway/src/rllm_model_gateway/server.py b/rllm-model-gateway/src/rllm_model_gateway/server.py
index 826d9722..ef898735 100644
--- a/rllm-model-gateway/src/rllm_model_gateway/server.py
+++ b/rllm-model-gateway/src/rllm_model_gateway/server.py
@@ -477,6 +477,7 @@ def _load_config(args: argparse.Namespace) -> GatewayConfig:
         "RLLM_GATEWAY_DB_PATH": "db_path",
         "RLLM_GATEWAY_LOG_LEVEL": "log_level",
         "RLLM_GATEWAY_STORE": "store_worker",
+        "RLLM_GATEWAY_ROUTING_POLICY": "routing_policy",
     }
     for env_key, config_key in env_map.items():
         val = os.environ.get(env_key)
diff --git a/rllm/gateway/manager.py b/rllm/gateway/manager.py
index a13f8143..1e34e182 100644
--- a/rllm/gateway/manager.py
+++ b/rllm/gateway/manager.py
@@ -29,6 +29,7 @@ For Tinker backends, an in-process handler is injected into the gateway
 from __future__ import annotations
 
 import logging
+import os
 import re
 import socket
 import subprocess
@@ -168,6 +169,8 @@ class GatewayManager:
         # renderer_family must be set explicitly (e.g. "qwen3", "glm-5").
         self.cumulative_token_mode: bool = gw_cfg.get("cumulative_token_mode", False)
         self.renderer_family: str = gw_cfg.get("renderer_family", "auto")
+        # Dotted path to a RoutingPolicy class (see rllm_model_gateway.session_router).
+        self.routing_policy: str | None = gw_cfg.get("routing_policy", None)
 
         self.mode = mode
 
@@ -362,12 +365,16 @@ class GatewayManager:
             if self.renderer_family != "auto":
                 cmd.extend(["--renderer-family", self.renderer_family])
 
+        env = os.environ.copy()
+        if self.routing_policy:
+            env["RLLM_GATEWAY_ROUTING_POLICY"] = self.routing_policy
+
         logger.info("Starting gateway subprocess: %s", " ".join(cmd))
         # Inherit parent's stdout/stderr so gateway logs are visible for debugging.
         # subprocess.PIPE causes problems as without an active reader, the OS pipe
         # buffer (~64KB on Linux) fills up under high-throughput logging, causing the
         # gateway process to block on write and eventually hang.
-        self._process = subprocess.Popen(cmd)
+        self._process = subprocess.Popen(cmd, env=env)
 
         # Poll health endpoint
         deadline = time.monotonic() + _HEALTH_POLL_TIMEOUT
@@ -400,6 +407,7 @@ class GatewayManager:
             add_return_token_ids=self.add_return_token_ids,
             cumulative_token_mode=self.cumulative_token_mode,
             renderer_family=self.renderer_family,
+            routing_policy=self.routing_policy,
         )
         app = create_app(config=gw_config, local_handler=local_handler)
 
-- 
