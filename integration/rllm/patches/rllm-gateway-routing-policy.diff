diff --git a/rllm/sandbox/backends/kubernetes_backend.py b/rllm/sandbox/backends/kubernetes_backend.py
new file mode 100644
index 00000000..34936604
--- /dev/null
+++ b/rllm/sandbox/backends/kubernetes_backend.py
@@ -0,0 +1,260 @@
+"""Kubernetes sandbox backend: one pod per task, exec-based I/O.
+
+Shaped after the Modal backend: non-interactive exec, base64-chunked file
+transfer, atexit sweeper for leaked sandboxes. Pods dial out to the gateway
+directly (cluster networking), so no tunnel is needed; pair with
+RLLM_GATEWAY_NO_LOOPBACK_PIN=1 so the gateway advertises a routable IP.
+
+Cluster knobs come from env:
+    RLLM_K8S_NAMESPACE          pod namespace (default: "default")
+    RLLM_K8S_NODE_SELECTOR      "k=v[,k=v]" node selector for task pods
+    RLLM_K8S_IMAGE_PULL_SECRET  optional imagePullSecrets name
+    RLLM_K8S_POD_TIMEOUT        seconds to wait for Running (default: 600)
+    RLLM_K8S_CPU_REQUEST        override cpu request for every task pod
+                                (e.g. "250m") - task.toml values assume
+                                dedicated capacity; high-concurrency smokes
+                                overcommit the CPU pool instead
+    RLLM_K8S_MEMORY_REQUEST_MB  override memory request (int MiB); the
+                                task.toml value stays as the LIMIT
+    RLLM_K8S_STORAGE_REQUEST_MB override ephemeral-storage request (int MiB).
+                                R2E task.toml declares 30720 (a whole
+                                dedicated disk); at that request only ~5 pods
+                                fit per node and the rest stay Pending with
+                                "Insufficient ephemeral-storage"
+    RLLM_K8S_IMAGE_PREFIX_MAP   "src=dst[,src=dst]" image-ref prefix rewrite,
+                                e.g. "namanjain12/=REGION-docker.pkg.dev/...
+                                /r2e/namanjain12/" - task metadata keeps the
+                                canonical Docker Hub refs while pods pull from
+                                an in-region mirror (Hub rate limits)
+"""
+
+import atexit
+import base64
+import io
+import logging
+import os
+import re
+import shlex
+import tarfile
+import time
+import uuid
+import weakref
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+_CHUNK_BYTES = 49_152  # keep each exec argv comfortably under ARG_MAX
+
+_live_sandboxes: "weakref.WeakSet[KubernetesSandbox]" = weakref.WeakSet()
+
+
+def _sweep() -> None:
+    for sandbox in list(_live_sandboxes):
+        try:
+            sandbox.close()
+        except Exception:
+            pass
+
+
+atexit.register(_sweep)
+
+
+class KubernetesSandbox:
+    """Sandbox protocol implementation backed by a Kubernetes pod."""
+
+    def __init__(
+        self,
+        image: str,
+        name: str | None = None,
+        cpu: float | None = None,
+        memory_mb: int | None = None,
+        storage_mb: int | None = None,
+        **_ignored,
+    ) -> None:
+        try:
+            from kubernetes import client, config
+        except ImportError as e:  # pragma: no cover
+            raise ImportError("KubernetesSandbox requires the 'kubernetes' package (pip install kubernetes)") from e
+
+        try:
+            config.load_incluster_config()
+        except config.ConfigException:
+            config.load_kube_config()
+
+        self._core = client.CoreV1Api()
+        self._namespace = os.environ.get("RLLM_K8S_NAMESPACE", "default")
+        for pair in filter(None, os.environ.get("RLLM_K8S_IMAGE_PREFIX_MAP", "").split(",")):
+            src, sep, dst = pair.partition("=")
+            if sep and image.startswith(src):
+                image = dst + image[len(src):]
+                break
+        # Task ids (e.g. "orange3__abc") are not valid RFC-1123 pod names;
+        # sanitize and always suffix a nonce so retries never collide with a
+        # terminating pod of the same task.
+        stem = re.sub(r"[^a-z0-9-]+", "-", f"rllm-sandbox-{name or ''}".lower()).strip("-")
+        self._name = f"{stem[:52].rstrip('-')}-{uuid.uuid4().hex[:8]}"
+        self._closed = False
+
+        resources: dict[str, dict[str, str]] = {"requests": {}, "limits": {}}
+        cpu_request = os.environ.get("RLLM_K8S_CPU_REQUEST") or (str(cpu) if cpu else None)
+        if cpu_request:
+            resources["requests"]["cpu"] = cpu_request
+        memory_request = os.environ.get("RLLM_K8S_MEMORY_REQUEST_MB")
+        if memory_request:
+            resources["requests"]["memory"] = f"{int(memory_request)}Mi"
+            if memory_mb:
+                resources["limits"]["memory"] = f"{int(memory_mb)}Mi"
+        elif memory_mb:
+            resources["requests"]["memory"] = f"{int(memory_mb)}Mi"
+            resources["limits"]["memory"] = f"{int(memory_mb)}Mi"
+        storage_request = os.environ.get("RLLM_K8S_STORAGE_REQUEST_MB")
+        if storage_request:
+            resources["requests"]["ephemeral-storage"] = f"{int(storage_request)}Mi"
+            if storage_mb:
+                resources["limits"]["ephemeral-storage"] = f"{int(storage_mb)}Mi"
+        elif storage_mb:
+            resources["requests"]["ephemeral-storage"] = f"{int(storage_mb)}Mi"
+
+        node_selector = {}
+        raw_selector = os.environ.get("RLLM_K8S_NODE_SELECTOR", "")
+        for pair in filter(None, raw_selector.split(",")):
+            key, _, value = pair.partition("=")
+            node_selector[key.strip()] = value.strip()
+
+        spec: dict = {
+            "restartPolicy": "Never",
+            "terminationGracePeriodSeconds": 5,
+            "containers": [
+                {
+                    "name": "sandbox",
+                    "image": image,
+                    "command": ["sleep", "infinity"],
+                    "resources": {k: v for k, v in resources.items() if v},
+                }
+            ],
+        }
+        if node_selector:
+            spec["nodeSelector"] = node_selector
+        pull_secret = os.environ.get("RLLM_K8S_IMAGE_PULL_SECRET")
+        if pull_secret:
+            spec["imagePullSecrets"] = [{"name": pull_secret}]
+
+        manifest = {
+            "apiVersion": "v1",
+            "kind": "Pod",
+            "metadata": {"name": self._name, "labels": {"app": "rllm-sandbox"}},
+            "spec": spec,
+        }
+        self._core.create_namespaced_pod(namespace=self._namespace, body=manifest)
+        _live_sandboxes.add(self)
+        self._wait_running(float(os.environ.get("RLLM_K8S_POD_TIMEOUT", "600")))
+        logger.info("KubernetesSandbox %s running (image=%s)", self._name, image)
+
+    # -- Sandbox protocol ----------------------------------------------------
+
+    def exec(self, command: str, timeout: float | None = None, user: str | None = None) -> str:
+        from kubernetes.stream import stream
+
+        shell = ["bash", "-c", command]
+        if user:
+            # k8s exec has no user switch; runuser needs root in the pod,
+            # which R2E/testbed images run as.
+            shell = ["runuser", "-u", user, "--", "bash", "-c", command]
+
+        resp = stream(
+            self._core.connect_get_namespaced_pod_exec,
+            self._name,
+            self._namespace,
+            command=shell,
+            container="sandbox",
+            stderr=True,
+            stdin=False,
+            stdout=True,
+            tty=False,
+            _preload_content=False,
+        )
+        deadline = time.monotonic() + timeout if timeout else None
+        stdout_parts: list[str] = []
+        stderr_parts: list[str] = []
+        while resp.is_open():
+            resp.update(timeout=1)
+            if resp.peek_stdout():
+                stdout_parts.append(resp.read_stdout())
+            if resp.peek_stderr():
+                stderr_parts.append(resp.read_stderr())
+            if deadline and time.monotonic() > deadline:
+                resp.close()
+                raise RuntimeError(f"exec timed out after {timeout}s: {command[:200]}")
+        # Drain anything buffered after the channel closed.
+        if resp.peek_stdout():
+            stdout_parts.append(resp.read_stdout())
+        if resp.peek_stderr():
+            stderr_parts.append(resp.read_stderr())
+        returncode = resp.returncode
+        if returncode != 0:
+            stderr_tail = "".join(stderr_parts)[-600:]
+            raise RuntimeError(f"exec failed (rc={returncode}): {stderr_tail}")
+        return "".join(stdout_parts)
+
+    def upload_file(self, local_path: str | Path, remote_path: str | Path) -> None:
+        data = Path(local_path).read_bytes()
+        remote = str(remote_path)
+        parent = os.path.dirname(remote) or "/"
+        staging = f"/tmp/.rllm-upload-{uuid.uuid4().hex[:8]}"
+        self.exec(f"mkdir -p {shlex.quote(parent)} && : > {staging}")
+        for offset in range(0, len(data), _CHUNK_BYTES):
+            chunk = base64.b64encode(data[offset : offset + _CHUNK_BYTES]).decode()
+            self.exec(f"printf %s {chunk} >> {staging}")
+        self.exec(f"base64 -d {staging} > {shlex.quote(remote)} && rm -f {staging}")
+
+    def upload_dir(self, local_path: str | Path, remote_path: str | Path) -> None:
+        buffer = io.BytesIO()
+        with tarfile.open(fileobj=buffer, mode="w:gz") as tar:
+            tar.add(str(local_path), arcname=".")
+        data = buffer.getvalue()
+        remote = str(remote_path)
+        staging = f"/tmp/.rllm-upload-{uuid.uuid4().hex[:8]}"
+        self.exec(f"mkdir -p {shlex.quote(remote)} && : > {staging}")
+        for offset in range(0, len(data), _CHUNK_BYTES):
+            chunk = base64.b64encode(data[offset : offset + _CHUNK_BYTES]).decode()
+            self.exec(f"printf %s {chunk} >> {staging}")
+        self.exec(
+            f"base64 -d {staging} | tar xzf - --no-same-owner -C {shlex.quote(remote)} && rm -f {staging}"
+        )
+
+    def is_alive(self) -> bool:
+        if self._closed:
+            return False
+        try:
+            pod = self._core.read_namespaced_pod(name=self._name, namespace=self._namespace)
+            return pod.status.phase == "Running"
+        except Exception:
+            return False
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        try:
+            self._core.delete_namespaced_pod(
+                name=self._name, namespace=self._namespace, grace_period_seconds=5
+            )
+        except Exception:
+            logger.debug("KubernetesSandbox %s already gone", self._name)
+        _live_sandboxes.discard(self)
+
+    # -- Internal ------------------------------------------------------------
+
+    def _wait_running(self, timeout: float) -> None:
+        deadline = time.monotonic() + timeout
+        last_phase = "Unknown"
+        while time.monotonic() < deadline:
+            pod = self._core.read_namespaced_pod(name=self._name, namespace=self._namespace)
+            last_phase = pod.status.phase or "Unknown"
+            if last_phase == "Running":
+                return
+            if last_phase in ("Failed", "Succeeded"):
+                break
+            time.sleep(2)
+        self.close()
+        raise RuntimeError(f"pod {self._name} not Running after {timeout}s (phase={last_phase})")
