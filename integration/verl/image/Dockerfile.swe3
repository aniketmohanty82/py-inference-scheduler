# swe3 = swe2 + the mooncake store connector preemption-orphan fix baked in.
#
# The fix ran pod-local during the pressure-pair's store arm (a worker pod
# replacement silently reverts pod-local edits, which is unacceptable for
# anything longer than a hot-fix). The patch script is exact-anchor,
# idempotent, and py_compiles the result - the build fails loudly if the
# vendored connector ever drifts.
#
# Build: docker build -f integration/verl/image/Dockerfile.swe3 \
#          -t us-south1-docker.pkg.dev/aniket-gke-dev/llm-images/rllm-verl-mooncake:swe3 \
#          <repo-root>
FROM us-south1-docker.pkg.dev/aniket-gke-dev/llm-images/rllm-verl-mooncake:swe2

COPY benchmark-results/verl-swe-ab/pressure-pair/connector_preemption_orphan_patch.py /tmp/patch_worker.py
RUN python3 /tmp/patch_worker.py && rm /tmp/patch_worker.py
